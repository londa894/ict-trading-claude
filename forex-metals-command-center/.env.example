# Copy to .env (never commit .env). All provider credentials stay server-side.
# There are NO broker credentials anywhere in this system, by design.

# --- API (services/api) ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://fmcc:fmcc@localhost:5432/fmcc
REDIS_URL=redis://localhost:6379/0

# Independent market-data provider: "unconfigured" (default, fails safe) or "fixture" (SYNTHETIC dev data).
# Real vendors are added behind the MarketDataProvider interface in later phases. TradingView is rejected.
MARKET_DATA_PROVIDER=unconfigured
MARKET_DATA_API_KEY=

EXECUTION_TIMEFRAME=M5
CORS_ORIGINS=http://localhost:3000

# Manual account profile for the risk engine (copy config/risk_profile.example.json to a *.local.json file,
# which is git-ignored). Unset -> risk status NOT_CONFIGURED and the decision is blocked by RISK_PROFILE_MISSING.
# Relative paths resolve from the API working directory (services/api).
RISK_PROFILE_PATH=

# Background alert monitor inside the API process (Phase 11). Alerts and ready watches are kept in memory.
ALERT_MONITOR_ENABLED=true

# AI assistant (Phase 12). deterministic = offline explainer (default). anthropic = Claude with read-only tools;
# the key stays server-side, answers must pass the grounding guard, account amounts are withheld unless shared.
AI_PROVIDER=deterministic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_SHARE_ACCOUNT_DATA=false

# Economic calendar / news gate (Phase 13): unconfigured (default, blocks: news cannot be proven clear),
# fixture (SYNTHETIC schedule, never clears the gate) or file (a server-side JSON calendar you maintain;
# see config/calendar.example.json). The file must be fetched < 24 h ago and cover the next 24 h.
CALENDAR_PROVIDER=unconfigured
CALENDAR_FILE_PATH=

# --- Basic macro (Phase 14) ---
# Macro is context: it adjusts score/confidence and never blocks. unconfigured (default) leaves the MACRO factor
# NOT_EVALUATED; fixture = SYNTHETIC series (shown, never scored); file = a server-side JSON of daily series
# (DXY required; US2Y, US10Y, US10Y_REAL, VIX optional; >= 25 observations; stale after 4 days).
# See config/macro.example.json (example values only).
MACRO_PROVIDER=unconfigured
MACRO_FILE_PATH=

# --- Journal (Phase 15) ---
# Private manual records with immutable engine snapshots. unconfigured (default) saves nothing and says so.
# database = use DATABASE_URL (the docker-compose Postgres, or e.g. sqlite+pysqlite:///./data/journal.db for a
# local file); create the tables first with `uv run alembic upgrade head` in services/api.
JOURNAL_STORE=unconfigured

# --- Paper trading (Phase 16) ---
# Broker-free simulation on the independent market data (nothing is sent anywhere). unconfigured (default) simulates
# nothing. database = use DATABASE_URL after `uv run alembic upgrade head`. The monitor advances pending/open sims
# every advanceSeconds (paper.json); reads advance them too. Costs in paper.json are assumptions, not broker specs.
PAPER_STORE=unconfigured
PAPER_MONITOR_ENABLED=true

# --- Backtesting (Phase 18) ---
# Research replays of the live setup engine over closed history (background jobs, one at a time, max 14 days per
# run). unconfigured (default) runs nothing. database = use DATABASE_URL after `uv run alembic upgrade head`.
BACKTEST_STORE=unconfigured

# --- Replay (Phase 19) ---
# No settings: replay sessions are in memory (limits in packages/strategy-spec/replay.json) and read the market data
# provider above. Sessions are lost on restart.

# --- Postgres (docker-compose) ---
POSTGRES_USER=fmcc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fmcc

# --- Web (apps/web) --- public, contains no secrets
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Web server only (never NEXT_PUBLIC_) --- local TradingView Desktop control via the MCP bridge
# Absolute path to tradingview-mcp's src/server.js. Unset -> the TradingView switcher shows NOT CONNECTED.
TRADINGVIEW_MCP_SERVER_PATH=
