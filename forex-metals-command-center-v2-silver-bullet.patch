@@ -0,0 +1,137 @@
+"""Configuration and wire models for the independent Silver Bullet setup family."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import UTC, date, datetime, time
+from enum import StrEnum
+from zoneinfo import ZoneInfo
+
+from app.contracts import load_spec
+from app.domain.base import ApiModel
+from app.domain.enums import AnalysisIneligibility, DataQuality, Direction, DisplacementGrade, Timeframe
+
+
+def _hm(value: str) -> time:
+    hours, minutes = value.split(":")
+    return time(int(hours), int(minutes))
+
+
+class SilverBulletWindow(StrEnum):
+    LONDON = "LONDON"
+    NEW_YORK_AM = "NEW_YORK_AM"
+    NEW_YORK_PM = "NEW_YORK_PM"
+
+
+class SilverBulletState(StrEnum):
+    ARMED = "ARMED"
+    FILLED = "FILLED"
+    ENTRY_MISSED = "ENTRY_MISSED"
+    EXPIRED = "EXPIRED"
+    BLOCKED = "BLOCKED"
+
+
+@dataclass(frozen=True)
+class SilverBulletWindowSpec:
+    name: SilverBulletWindow
+    start: time
+    end: time
+
+    def bounds(self, day: date, timezone: ZoneInfo) -> tuple[datetime, datetime]:
+        """Return UTC bounds for a New York calendar day, honoring DST."""
+        start = datetime.combine(day, self.start, tzinfo=timezone).astimezone(UTC)
+        end = datetime.combine(day, self.end, tzinfo=timezone).astimezone(UTC)
+        return start, end
+
+
+@dataclass(frozen=True)
+class SilverBulletConfig:
+    timezone: ZoneInfo
+    timeframe: Timeframe
+    default_bars: int
+    windows: tuple[SilverBulletWindowSpec, ...]
+    min_fvg_quality: float
+    min_displacement_grade: DisplacementGrade
+    stop_buffer_atr: float
+    min_risk_reward: float
+    entry_rule: str
+    stop_rule: str
+    target_rule: str
+    verdict_authority: str
+
+    @classmethod
+    def from_spec(cls) -> SilverBulletConfig:
+        spec = load_spec("silver_bullet")
+        windows = tuple(
+            SilverBulletWindowSpec(SilverBulletWindow(name), _hm(value["start"]), _hm(value["end"]))
+            for name, value in spec["windows"].items()
+        )
+        if {window.name for window in windows} != set(SilverBulletWindow):
+            raise ValueError("silver_bullet.json must define all three Silver Bullet windows")
+        if any(window.end <= window.start for window in windows):
+            raise ValueError("Silver Bullet windows must start and end on the same New York date")
+        timeframe = Timeframe(spec["timeframe"])
+        step = int(timeframe.duration.total_seconds() // 60)
+        if any(value.minute % step for window in windows for value in (window.start, window.end)):
+            raise ValueError("Silver Bullet windows must align with the configured timeframe")
+        if not 0 <= float(spec["minFvgQuality"]) <= 100:
+            raise ValueError("minFvgQuality must be in 0..100")
+        if int(spec["defaultBars"]) < 1:
+            raise ValueError("defaultBars must be positive")
+        if float(spec["stopBufferAtr"]) < 0 or float(spec["minRiskReward"]) <= 0:
+            raise ValueError("risk parameters must be positive")
+        if spec["entryRule"] != "PROXIMAL_EDGE":
+            raise ValueError("only PROXIMAL_EDGE entry is supported")
+        return cls(
+            timezone=ZoneInfo(spec["timezone"]),
+            timeframe=timeframe,
+            default_bars=int(spec["defaultBars"]),
+            windows=windows,
+            min_fvg_quality=float(spec["minFvgQuality"]),
+            min_displacement_grade=DisplacementGrade(spec["minDisplacementGrade"]),
+            stop_buffer_atr=float(spec["stopBufferAtr"]),
+            min_risk_reward=float(spec["minRiskReward"]),
+            entry_rule=str(spec["entryRule"]),
+            stop_rule=str(spec["stopRule"]),
+            target_rule=str(spec["targetRule"]),
+            verdict_authority=str(spec["verdictAuthority"]),
+        )
+
+
+class SilverBulletSetup(ApiModel):
+    id: str
+    setup_type: str = "SILVER_BULLET"
+    window: SilverBulletWindow
+    direction: Direction
+    state: SilverBulletState
+    formed_at: datetime
+    window_start: datetime
+    window_end: datetime
+    fvg_id: str
+    displacement_id: str | None
+    structural_swing_id: str | None
+    target_pool_id: str | None
+    entry: float | None
+    stop: float | None
+    target: float | None
+    risk_reward: float | None
+    filled_at: datetime | None
+    blockers: list[str]
+    next_required_event: str
+
+
+class SilverBulletAnalysis(ApiModel):
+    symbol: str
+    setup_type: str = "SILVER_BULLET"
+    timeframe: Timeframe
+    as_of: datetime | None
+    candle_count: int
+    quality: DataQuality
+    eligible_for_decision: bool
+    ineligibility: list[AnalysisIneligibility]
+    setups: list[SilverBulletSetup]
+    verdict_authority: str
+    requested_end: datetime | None
+    provider_error: str | None
+    strategy_version: str
+    generated_at: datetime
