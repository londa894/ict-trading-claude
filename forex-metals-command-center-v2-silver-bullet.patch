--- /dev/null
+++ b/services/api/app/services/silver_bullet/engine.py
@@ -0,0 +1,348 @@
+"""Pure Silver Bullet detector (closed M5 candles, New York wall-clock windows, no lookahead)."""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+from datetime import datetime
+
+from app.domain.enums import (
+    Direction,
+    DisplacementGrade,
+    LiquiditySide,
+    PdArrayType,
+    SwingKind,
+)
+from app.domain.models import Candle
+from app.services.displacement.engine import DisplacementEvent
+from app.services.fvg.engine import PdArray
+from app.services.liquidity.models import LiquidityPool
+from app.services.silver_bullet.models import (
+    SilverBulletConfig,
+    SilverBulletSetup,
+    SilverBulletState,
+    SilverBulletWindowSpec,
+)
+from app.services.structure.models import Swing
+
+GRADE_RANK = {grade: index for index, grade in enumerate(DisplacementGrade)}
+
+
+@dataclass(frozen=True)
+class SilverBulletInputs:
+    candles: Sequence[Candle]
+    pd_arrays: Sequence[PdArray]
+    displacements: Sequence[DisplacementEvent]
+    swings: Sequence[Swing]
+    pools: Sequence[LiquidityPool]
+    gap_after: set[datetime] = field(default_factory=set)
+    price_precision: int = 2
+
+
+def _window_for(
+    known_at: datetime, cfg: SilverBulletConfig
+) -> tuple[SilverBulletWindowSpec, datetime, datetime] | None:
+    local_day = known_at.astimezone(cfg.timezone).date()
+    for window in cfg.windows:
+        start, end = window.bounds(local_day, cfg.timezone)
+        if start <= known_at < end:
+            return window, start, end
+    return None
+
+
+def _displacement(
+    array: PdArray, inputs: SilverBulletInputs, cfg: SilverBulletConfig
+) -> DisplacementEvent | None:
+    matches = [
+        event
+        for event in inputs.displacements
+        if event.id == array.displacement_event_id
+        and event.direction is array.direction
+        and event.known_at <= array.known_at
+        and event.created_fvg
+        and not event.across_gap
+        and GRADE_RANK[event.grade] >= GRADE_RANK[cfg.min_displacement_grade]
+    ]
+    return max(matches, key=lambda event: (event.known_at, event.id)) if matches else None
+
+
+def _structural_swing(array: PdArray, inputs: SilverBulletInputs) -> Swing | None:
+    bullish = array.direction is Direction.BULLISH
+    entry = array.high if bullish else array.low
+    kind = SwingKind.LOW if bullish else SwingKind.HIGH
+    matches = [
+        swing
+        for swing in inputs.swings
+        if swing.kind is kind
+        and swing.known_at <= array.known_at
+        and not swing.across_gap
+        and (swing.price < entry if bullish else swing.price > entry)
+    ]
+    return max(matches, key=lambda swing: (swing.known_at, swing.time, swing.id)) if matches else None
+
+
+def _target(array: PdArray, entry: float, inputs: SilverBulletInputs) -> LiquidityPool | None:
+    bullish = array.direction is Direction.BULLISH
+    side = LiquiditySide.BSL if bullish else LiquiditySide.SSL
+    matches = [
+        pool
+        for pool in inputs.pools
+        if pool.side is side
+        and pool.known_at <= array.known_at
+        and (pool.taken_at is None or pool.taken_at > array.known_at)
+        and not pool.data_gap
+        and (pool.price > entry if bullish else pool.price < entry)
+    ]
+    return min(matches, key=lambda pool: (abs(pool.price - entry), pool.id)) if matches else None
+
+
+def _blocked(
+    array: PdArray,
+    window: SilverBulletWindowSpec,
+    start: datetime,
+    end: datetime,
+    reason: str,
+    *,
+    displacement: DisplacementEvent | None = None,
+    swing: Swing | None = None,
+    target: LiquidityPool | None = None,
+    entry: float | None = None,
+    stop: float | None = None,
+    target_price: float | None = None,
+    risk_reward: float | None = None,
+) -> SilverBulletSetup:
+    return SilverBulletSetup(
+        id=f"SB-{window.name.value}-{array.id}",
+        window=window.name,
+        direction=array.direction,
+        state=SilverBulletState.BLOCKED,
+        formed_at=array.known_at,
+        window_start=start,
+        window_end=end,
+        fvg_id=array.id,
+        displacement_id=displacement.id if displacement else None,
+        structural_swing_id=swing.id if swing else None,
+        target_pool_id=target.id if target else None,
+        entry=entry,
+        stop=stop,
+        target=target_price,
+        risk_reward=risk_reward,
+        filled_at=None,
+        blockers=[reason],
+        next_required_event="none (candidate blocked)",
+    )
+
+
+def _candidate(
+    array: PdArray,
+    window: SilverBulletWindowSpec,
+    start: datetime,
+    end: datetime,
+    inputs: SilverBulletInputs,
+    cfg: SilverBulletConfig,
+    closed: Sequence[Candle],
+) -> SilverBulletSetup:
+    displacement = _displacement(array, inputs, cfg)
+    if displacement is None:
+        return _blocked(array, window, start, end, "NO_CAUSAL_DISPLACEMENT")
+
+    swing = _structural_swing(array, inputs)
+    if swing is None:
+        return _blocked(array, window, start, end, "NO_STRUCTURAL_INVALIDATION", displacement=displacement)
+
+    bullish = array.direction is Direction.BULLISH
+    entry = array.high if bullish else array.low
+    buffer = displacement.atr * cfg.stop_buffer_atr
+    stop = swing.price - buffer if bullish else swing.price + buffer
+    stop = round(stop, inputs.price_precision)
+    if (bullish and stop >= entry) or (not bullish and stop <= entry):
+        return _blocked(
+            array,
+            window,
+            start,
+            end,
+            "INVALID_STOP_GEOMETRY",
+            displacement=displacement,
+            swing=swing,
+            entry=entry,
+            stop=stop,
+        )
+
+    target = _target(array, entry, inputs)
+    if target is None:
+        return _blocked(
+            array,
+            window,
+            start,
+            end,
+            "NO_LIQUIDITY_TARGET",
+            displacement=displacement,
+            swing=swing,
+            entry=entry,
+            stop=stop,
+        )
+
+    risk = abs(entry - stop)
+    reward = abs(target.price - entry)
+    risk_reward = round(reward / risk, 2)
+    if risk_reward < cfg.min_risk_reward:
+        return _blocked(
+            array,
+            window,
+            start,
+            end,
+            "RISK_REWARD_BELOW_MINIMUM",
+            displacement=displacement,
+            swing=swing,
+            target=target,
+            entry=entry,
+            stop=stop,
+            target_price=target.price,
+            risk_reward=risk_reward,
+        )
+
+    eligible = [
+        candle for candle in closed if candle.open_time >= array.known_at and candle.close_time <= end
+    ]
+    touches = [
+        candle for candle in eligible if (candle.low <= array.high if bullish else candle.high >= array.low)
+    ]
+    touch = touches[0] if touches else None
+    target_hits = [
+        candle
+        for candle in eligible
+        if (candle.high >= target.price if bullish else candle.low <= target.price)
+    ]
+    target_hit = target_hits[0] if target_hits else None
+    as_of = closed[-1].close_time if closed else None
+    relevant_end = min(end, as_of) if as_of is not None else array.known_at
+    if any(array.known_at <= gap < relevant_end for gap in inputs.gap_after):
+        return _blocked(
+            array,
+            window,
+            start,
+            end,
+            "DATA_GAP_BEFORE_ENTRY",
+            displacement=displacement,
+            swing=swing,
+            target=target,
+            entry=entry,
+            stop=stop,
+            target_price=target.price,
+            risk_reward=risk_reward,
+        )
+    if touch is not None:
+        if target_hit is not None and target_hit.open_time == touch.open_time:
+            return _blocked(
+                array,
+                window,
+                start,
+                end,
+                "INTRABAR_ENTRY_TARGET_AMBIGUITY",
+                displacement=displacement,
+                swing=swing,
+                target=target,
+                entry=entry,
+                stop=stop,
+                target_price=target.price,
+                risk_reward=risk_reward,
+            )
+        stop_touched = touch.low <= stop if bullish else touch.high >= stop
+        if stop_touched:
+            return _blocked(
+                array,
+                window,
+                start,
+                end,
+                "INTRABAR_ENTRY_STOP_AMBIGUITY",
+                displacement=displacement,
+                swing=swing,
+                target=target,
+                entry=entry,
+                stop=stop,
+                target_price=target.price,
+                risk_reward=risk_reward,
+            )
+
+    if target_hit is not None and (touch is None or target_hit.open_time < touch.open_time):
+        return SilverBulletSetup(
+            id=f"SB-{window.name.value}-{array.id}",
+            window=window.name,
+            direction=array.direction,
+            state=SilverBulletState.ENTRY_MISSED,
+            formed_at=array.known_at,
+            window_start=start,
+            window_end=end,
+            fvg_id=array.id,
+            displacement_id=displacement.id,
+            structural_swing_id=swing.id,
+            target_pool_id=target.id,
+            entry=entry,
+            stop=stop,
+            target=target.price,
+            risk_reward=risk_reward,
+            filled_at=None,
+            blockers=[],
+            next_required_event="none (target liquidity reached before retracement)",
+        )
+
+    state = (
+        SilverBulletState.FILLED
+        if touch is not None
+        else SilverBulletState.EXPIRED
+        if as_of is not None and as_of >= end
+        else SilverBulletState.ARMED
+    )
+    next_event = (
+        "manage the research outcome against structural stop and liquidity target"
+        if state is SilverBulletState.FILLED
+        else "none (window ended without retracement)"
+        if state is SilverBulletState.EXPIRED
+        else f"retracement to the FVG proximal edge before {end.isoformat()}"
+    )
+    return SilverBulletSetup(
+        id=f"SB-{window.name.value}-{array.id}",
+        window=window.name,
+        direction=array.direction,
+        state=state,
+        formed_at=array.known_at,
+        window_start=start,
+        window_end=end,
+        fvg_id=array.id,
+        displacement_id=displacement.id,
+        structural_swing_id=swing.id,
+        target_pool_id=target.id,
+        entry=entry,
+        stop=stop,
+        target=target.price,
+        risk_reward=risk_reward,
+        filled_at=touch.close_time if touch else None,
+        blockers=[],
+        next_required_event=next_event,
+    )
+
+
+def run_silver_bullet(
+    inputs: SilverBulletInputs, cfg: SilverBulletConfig | None = None
+) -> list[SilverBulletSetup]:
+    """Return one explainable candidate per qualifying in-window FVG."""
+    cfg = cfg or SilverBulletConfig.from_spec()
+    closed = sorted(
+        (candle for candle in inputs.candles if candle.is_closed and candle.timeframe is cfg.timeframe),
+        key=lambda candle: candle.open_time,
+    )
+    arrays = sorted(inputs.pd_arrays, key=lambda array: (array.known_at, array.id))
+    setups: list[SilverBulletSetup] = []
+    for array in arrays:
+        if (
+            array.type is not PdArrayType.FVG
+            or array.timeframe is not cfg.timeframe
+            or array.quality_score < cfg.min_fvg_quality
+        ):
+            continue
+        match = _window_for(array.known_at, cfg)
+        if match is None:
+            continue
+        window, start, end = match
+        setups.append(_candidate(array, window, start, end, inputs, cfg, closed))
+    return setups
