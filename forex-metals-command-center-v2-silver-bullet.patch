@@ -0,0 +1,65 @@
+"""Silver Bullet application service on the shared validated candle/FVG/liquidity engines."""
+
+from __future__ import annotations
+
+from datetime import datetime
+
+from app.contracts import strategy_version
+from app.domain.models import get_instrument
+from app.services.candles.service import CandleService, ChartRequestError
+from app.services.fvg.service import FvgService
+from app.services.silver_bullet.engine import SilverBulletInputs, run_silver_bullet
+from app.services.silver_bullet.models import SilverBulletAnalysis, SilverBulletConfig
+
+
+class SilverBulletService:
+    def __init__(
+        self,
+        candles: CandleService,
+        fvg: FvgService,
+        cfg: SilverBulletConfig | None = None,
+    ) -> None:
+        self._candles = candles
+        self._fvg = fvg
+        self.cfg = cfg or SilverBulletConfig.from_spec()
+
+    async def analyze(
+        self,
+        symbol: str,
+        bars: int | None = None,
+        end: datetime | None = None,
+    ) -> SilverBulletAnalysis:
+        size = self.cfg.default_bars if bars is None else bars
+        series = await self._candles.load_series(symbol, self.cfg.timeframe, size, end)
+        fvg, structure, liquidity = await self._fvg.run_series(series, end)
+        instrument = get_instrument(series.symbol)
+        if instrument is None:
