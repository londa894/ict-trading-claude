index 0000000..a2cd4bb
--- /dev/null
+++ b/services/api/tests/unit/test_silver_bullet.py
@@ -0,0 +1,282 @@
+"""Silver Bullet setup family: New York windows, causality, structural risk, and expiry."""
+
+from datetime import UTC, date, datetime, timedelta
+
+from app.domain.enums import (
+    DataQuality,
+    Direction,
+    DisplacementGrade,
+    LiquidityKind,
+    LiquiditySide,
+    LiquidityState,
+    PdArrayState,
+    PdArrayType,
+    StructureLevel,
+    SwingKind,
+    SwingLabel,
+    Timeframe,
+)
+from app.domain.models import Candle
+from app.services.displacement.engine import DisplacementEvent
+from app.services.fvg.engine import PdArray, QualityBreakdown
+from app.services.liquidity.models import LiquidityPool
+from app.services.silver_bullet.engine import SilverBulletInputs, run_silver_bullet
+from app.services.silver_bullet.models import SilverBulletConfig, SilverBulletState, SilverBulletWindow
+from app.services.structure.models import Swing
+
+BAR = timedelta(minutes=5)
+
+
+def at(hour: int, minute: int = 0, *, day: int = 5) -> datetime:
+    """March 5, 2024 is EST: New York = UTC - 5."""
+    return datetime(2024, 3, day, hour + 5, minute, tzinfo=UTC)
+
+
+def candle(t: datetime, o: float, h: float, lo: float, c: float) -> Candle:
+    return Candle(
+        symbol="XAUUSD",
+        timeframe=Timeframe.M5,
+        open_time=t,
+        close_time=t + BAR,
+        open=o,
+        high=h,
+        low=lo,
+        close=c,
+        volume=1.0,
+        source="test",
+        is_closed=True,
+        data_quality=DataQuality.CURRENT,
+    )
+
+
+def displacement(known: datetime, direction: Direction = Direction.BULLISH) -> DisplacementEvent:
+    return DisplacementEvent(
+        id="D-1",
+        run_id="D-RUN",
+        direction=direction,
+        grade=DisplacementGrade.STRONG,
+        start_time=known - 2 * BAR,
+        end_time=known - BAR,
+        known_at=known,
+        bars=2,
+        net_move=4.0 if direction is Direction.BULLISH else -4.0,
+        net_atr=2.0,
+        atr=2.0,
+        avg_body_pct=0.8,
+        created_fvg=True,
+        capped=False,
+        across_gap=False,
+        supersedes=None,
+        detail="",
+    )
+
+
+def fvg(known: datetime, direction: Direction = Direction.BULLISH) -> PdArray:
+    low, high = (2000.0, 2002.0)
+    return PdArray(
+        id="FVG-1",
+        symbol="XAUUSD",
+        timeframe=Timeframe.M5,
+        type=PdArrayType.FVG,
+        direction=direction,
+        high=high,
+        low=low,
+        midpoint=2001.0,
+        created_at=known - BAR,
+        known_at=known,
+        source_id=None,
+        size_atr=1.0,
+        state=PdArrayState.FRESH,
+        ifvg_status=None,
+        mitigation_pct=0.0,
+        touched_at=None,
+        invalidated_at=None,
+        bars_since_created=0,
+        freshness=1.0,
+        quality_score=70.0,
+        quality=QualityBreakdown(size=1.0, displacement=1.0, structure=0.0),
+        displacement_event_id="D-1",
+        structure_event_id=None,
+        timeframe_weight=1.0,
+        distance_atr=None,
+    )
+
+
+def swing(known: datetime, direction: Direction = Direction.BULLISH) -> Swing:
+    return Swing(
+        id="SWING-1",
+        level=StructureLevel.INTERNAL,
+        kind=SwingKind.LOW if direction is Direction.BULLISH else SwingKind.HIGH,
+        label=SwingLabel.HL if direction is Direction.BULLISH else SwingLabel.LH,
+        price=1998.0 if direction is Direction.BULLISH else 2004.0,
+        time=known - 4 * BAR,
+        known_at=known - BAR,
+        across_gap=False,
+    )
+
+
+def pool(known: datetime, direction: Direction = Direction.BULLISH) -> LiquidityPool:
+    return LiquidityPool(
+        id="TARGET-1",
+        kind=LiquidityKind.PDH if direction is Direction.BULLISH else LiquidityKind.PDL,
+        side=LiquiditySide.BSL if direction is Direction.BULLISH else LiquiditySide.SSL,
+        scope=StructureLevel.EXTERNAL,
+        price=2012.0 if direction is Direction.BULLISH else 1990.0,
+        label="target liquidity",
+        formed_at=known - timedelta(days=1),
+        known_at=known - BAR,
+        member_ids=[],
+        state=LiquidityState.FRESH,
+        state_since=None,
+        touched_at=None,
+        taken_at=None,
+        data_gap=False,
+        distance=None,
+        distance_atr=None,
+        magnet_score=80.0,
+        breakdown=None,
+    )
+
+
+def inputs(known: datetime, candles: list[Candle], **changes: object) -> SilverBulletInputs:
+    values: dict[str, object] = {
+        "candles": candles,
+        "pd_arrays": [fvg(known)],
+        "displacements": [displacement(known)],
+        "swings": [swing(known)],
+        "pools": [pool(known)],
+        "gap_after": set(),
+    }
+    values.update(changes)
+    return SilverBulletInputs(**values)  # type: ignore[arg-type]
+
+
+def test_config_has_three_dst_aware_new_york_windows() -> None:
+    cfg = SilverBulletConfig.from_spec()
+    assert cfg.timezone.key == "America/New_York"
+    assert [(w.name, w.start.isoformat(), w.end.isoformat()) for w in cfg.windows] == [
+        (SilverBulletWindow.LONDON, "03:00:00", "04:00:00"),
+        (SilverBulletWindow.NEW_YORK_AM, "10:00:00", "11:00:00"),
+        (SilverBulletWindow.NEW_YORK_PM, "14:00:00", "15:00:00"),
+    ]
+
+
+def test_window_bounds_follow_new_york_dst_not_fixed_utc() -> None:
+    cfg = SilverBulletConfig.from_spec()
+    london = cfg.windows[0]
+    winter, _ = london.bounds(date(2024, 3, 5), cfg.timezone)
+    summer, _ = london.bounds(date(2024, 3, 12), cfg.timezone)
+    assert winter.hour == 8 and summer.hour == 7
+
+
+def test_forms_and_fills_only_after_fvg_is_known_inside_window() -> None:
+    known = at(3, 20)
+    candles = [
+        candle(at(3, 15), 1999, 2003, 1999, 2003),
+        candle(at(3, 20), 2003, 2004, 2002.5, 2003.5),
+        candle(at(3, 25), 2003.5, 2004, 2001.5, 2003),
+    ]
+    result = run_silver_bullet(inputs(known, candles), SilverBulletConfig.from_spec())
+    assert len(result) == 1
+    setup = result[0]
+    assert setup.window is SilverBulletWindow.LONDON
+    assert setup.state is SilverBulletState.FILLED
+    assert setup.formed_at == known and setup.filled_at == at(3, 30)
+    assert setup.entry == 2002.0
+    assert setup.stop == 1997.8
+    assert setup.target == 2012.0
+    assert setup.risk_reward == 2.38
+
+
+def test_fvg_known_before_or_at_window_end_is_not_a_candidate() -> None:
+    cfg = SilverBulletConfig.from_spec()
+    for known in (at(2, 55), at(4, 0)):
+        candles = [candle(known, 2000, 2004, 1999, 2003)]
+        assert run_silver_bullet(inputs(known, candles), cfg) == []
+
+
+def test_requires_matching_causal_displacement() -> None:
+    known = at(10, 20)
+    bad = displacement(known + BAR)
+    candles = [candle(at(10, 20), 2003, 2004, 2002.5, 2003.5)]
+    result = run_silver_bullet(inputs(known, candles, displacements=[bad]), SilverBulletConfig.from_spec())
+    assert result[0].state is SilverBulletState.BLOCKED
+    assert result[0].blockers == ["NO_CAUSAL_DISPLACEMENT"]
+
+
+def test_requires_structural_invalidation_and_liquidity_target() -> None:
+    known = at(14, 20)
+    candles = [candle(at(14, 20), 2003, 2004, 2002.5, 2003.5)]
+    no_swing = run_silver_bullet(inputs(known, candles, swings=[]), SilverBulletConfig.from_spec())
+    no_target = run_silver_bullet(inputs(known, candles, pools=[]), SilverBulletConfig.from_spec())
+    assert no_swing[0].blockers == ["NO_STRUCTURAL_INVALIDATION"]
+    assert no_target[0].blockers == ["NO_LIQUIDITY_TARGET"]
+
+
+def test_blocks_subminimum_risk_reward_instead_of_forcing_a_trade() -> None:
+    known = at(10, 20)
+    close_target = pool(known).model_copy(update={"price": 2005.0})
+    candles = [candle(at(10, 20), 2003, 2004, 2002.5, 2003.5)]
+    result = run_silver_bullet(inputs(known, candles, pools=[close_target]), SilverBulletConfig.from_spec())
+    assert result[0].state is SilverBulletState.BLOCKED
+    assert result[0].blockers == ["RISK_REWARD_BELOW_MINIMUM"]
+
+
+def test_unfilled_setup_expires_at_window_end() -> None:
+    known = at(3, 20)
+    candles = [
+        candle(at(3, 20), 2003, 2004, 2002.5, 2003.5),
+        candle(at(3, 55), 2005, 2006, 2004, 2005),
+        candle(at(4, 0), 2005, 2006, 2004, 2005),
+    ]
+    result = run_silver_bullet(inputs(known, candles), SilverBulletConfig.from_spec())
+    assert result[0].state is SilverBulletState.EXPIRED
+    assert result[0].filled_at is None
+
+
+def test_gap_before_fill_blocks_candidate() -> None:
+    known = at(3, 20)
+    touch = candle(at(3, 25), 2003.5, 2004, 2001.5, 2003)
+    result = run_silver_bullet(
+        inputs(known, [candle(at(3, 20), 2003, 2004, 2002.5, 2003.5), touch], gap_after={touch.open_time}),
+        SilverBulletConfig.from_spec(),
+    )
+    assert result[0].state is SilverBulletState.BLOCKED
+    assert result[0].blockers == ["DATA_GAP_BEFORE_ENTRY"]
+
+
+def test_target_reached_before_retracement_marks_entry_missed() -> None:
+    known = at(3, 20)
+    candles = [
+        candle(at(3, 20), 2003, 2004, 2002.5, 2003.5),
+        candle(at(3, 25), 2004, 2012.5, 2003, 2011),
+    ]
+    result = run_silver_bullet(inputs(known, candles), SilverBulletConfig.from_spec())
+    assert result[0].state is SilverBulletState.ENTRY_MISSED
+    assert result[0].filled_at is None
+
+
+def test_same_candle_entry_and_target_is_blocked_as_intrabar_ambiguous() -> None:
+    known = at(3, 20)
+    candles = [
+        candle(at(3, 20), 2003, 2004, 2002.5, 2003.5),
+        candle(at(3, 25), 2003.5, 2012.5, 2001.5, 2010),
+    ]
+    result = run_silver_bullet(inputs(known, candles), SilverBulletConfig.from_spec())
+    assert result[0].state is SilverBulletState.BLOCKED
+    assert result[0].blockers == ["INTRABAR_ENTRY_TARGET_AMBIGUITY"]
+
+
+def test_unfilled_setup_with_gap_is_blocked_not_expired() -> None:
+    known = at(3, 20)
+    after_gap = candle(at(3, 55), 2005, 2006, 2004, 2005)
+    candles = [
+        candle(at(3, 20), 2003, 2004, 2002.5, 2003.5),
+        after_gap,
